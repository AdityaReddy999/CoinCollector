[sub_resource type="GDScript" id="GDScript_sybe4"]
script/source = "
extends CharacterBody2D

@export var speed: float = 65.0
@export var gravity: float = 980.0

var direction: int = -1

@onready var wall_ray: RayCast2D = $WallRay
@onready var floor_ray: RayCast2D = $FloorRay


func _ready():
	wall_ray.enabled = true
	floor_ray.enabled = true

	update_rays()


func _physics_process(delta):
	# Gravity
	if not is_on_floor():
		velocity.y += gravity * delta
	else:
		velocity.y = 0.0

	# Check for walls and platform edges
	update_rays()

	if is_on_wall():
		turn_around()
	elif is_on_floor() and not floor_ray.is_colliding():
		turn_around()

	# Walk automatically
	velocity.x = direction * speed

	move_and_slide()


func update_rays():
	# Look ahead for walls
	wall_ray.target_position = Vector2(12 * direction, 0)

	# Look down ahead for platform edges
	floor_ray.position = Vector2(12 * direction, 8)
	floor_ray.target_position = Vector2(0, 24)


func turn_around():
	direction *= -1
	update_rays()
"

