[sub_resource type="GDScript" id="GDScript_5vw27"]
script/source = "
extends Area2D

@onready var platform: TileMapLayer = get_parent()
@onready var trigger_shape: CollisionShape2D = $CollisionShape2D

var saved_tiles: Array[Dictionary] = []
var is_disappearing = false

func _ready():
	body_entered.connect(_on_body_entered)

func _on_body_entered(body):
	if body is CharacterBody2D and not is_disappearing:
		await remove_platform_tiles()

func remove_platform_tiles():
	is_disappearing = true
	saved_tiles.clear()

	# Give Mario half a second before disappearing!
	await get_tree().create_timer(4).timeout

	var shape = trigger_shape.shape as RectangleShape2D

	if shape == null:
		print(\"Use a RectangleShape2D!\")
		is_disappearing = false
		return

	var half_size = shape.size / 2.0

	var corners = [
		Vector2(-half_size.x, -half_size.y),
		Vector2(half_size.x, -half_size.y),
		Vector2(-half_size.x, half_size.y),
		Vector2(half_size.x, half_size.y)
	]

	var min_pos = Vector2(INF, INF)
	var max_pos = Vector2(-INF, -INF)

	for corner in corners:
		var world_corner = trigger_shape.to_global(corner)
		var local_corner = platform.to_local(world_corner)

		min_pos.x = min(min_pos.x, local_corner.x)
		min_pos.y = min(min_pos.y, local_corner.y)
		max_pos.x = max(max_pos.x, local_corner.x)
		max_pos.y = max(max_pos.y, local_corner.y)

	var first_cell = platform.local_to_map(min_pos)
	var last_cell = platform.local_to_map(max_pos)

	for x in range(first_cell.x, last_cell.x + 1):
		for y in range(first_cell.y, last_cell.y + 1):
			var cell = Vector2i(x, y)
			var source_id = platform.get_cell_source_id(cell)

			if source_id != -1:
				saved_tiles.append({
					\"cell\": cell,
					\"source_id\": source_id,
					\"atlas_coords\": platform.get_cell_atlas_coords(cell),
					\"alternative_tile\": platform.get_cell_alternative_tile(cell)
				})

				platform.erase_cell(cell)

	print(\"Platform disappeared!\")

	await get_tree().create_timer(4).timeout

	for tile in saved_tiles:
		platform.set_cell(
			tile[\"cell\"],
			tile[\"source_id\"],
			tile[\"atlas_coords\"],
			tile[\"alternative_tile\"]
		)

	print(\"Platform came back!\")

	saved_tiles.clear()
	is_disappearing = false
"

